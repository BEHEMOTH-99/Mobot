#include <WiFi.h>
#include <HTTPClient.h>

// Motor and sensor pins
const int motor1PWM = 36;
const int motor1PH = 35;
const int motor2PWM = 38;
const int motor2PH = 37;
const int distanceSensor = 16;

const int inputB = 4;  // Far left
const int inputR = 5;  // Left
const int inputO = 6;  // Middle
const int inputY = 7;  // Right
const int inputG = 15; // Far right

// Constants
const int speed = 150;
const int LightBoundary = 900;
volatile bool leftTurnFlag = false;
volatile bool rightTurnFlag = false;
volatile bool noTurnFlag = false;
volatile bool sharpRightTurnFlag = false;
volatile bool sharpLeftTurnFlag = false;
volatile bool parkFlag = false;
const bool parkMode = false;

// Wi-Fi credentials
const char* ssid = "iot";
const char* password = "gingal8mesocephal";

// Server details
const char* serverUrl = "http://3.250.38.184:8000/api/arrived/wjdn3765";

// Checkpoint variables
int lastCheckpoint;
int currentCheckpoint;
int nextCheckpoint;

void setMotor(bool M1direction, bool M2direction, int M1speed, int M2speed) {
  digitalWrite(motor1PH, M1direction);
  digitalWrite(motor2PH, M2direction);
  analogWrite(motor1PWM, M1speed);
  analogWrite(motor2PWM, M2speed);
}

int getNextCheckpoint() {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    http.begin(serverUrl);
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");

    String requestBody = "position=" + String(currentCheckpoint);
    int httpResponseCode = http.POST(requestBody);

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println("Response from server: " + response);

      if (response.toInt() != 0 || response == "0") { // Ensure valid integer
        http.end();
        return response.toInt();
      } else {
        Serial.println("Invalid response received from server");
      }
    } else {
      Serial.print("Error in sending POST request: ");
      Serial.println(http.errorToString(httpResponseCode));
    }

    http.end();
    return -1; // Error indicator
  } else {
    Serial.println("Wi-Fi not connected");
    return -1; // Error indicator
  }
}

void notifyServer(int position) {
  if (WiFi.status() == WL_CONNECTED) {
    HTTPClient http;
    Serial.println("Initializing HTTP request...");
    http.begin(serverUrl);
    http.addHeader("Content-Type", "application/x-www-form-urlencoded");

    String requestBody = "position=" + String(position);
    Serial.println("Sending request: " + requestBody);

    int httpResponseCode = http.POST(requestBody);

    if (httpResponseCode > 0) {
      String response = http.getString();
      Serial.println("Response from server: " + response);
    } else {
      Serial.print("Error in sending POST request: ");
      Serial.println(http.errorToString(httpResponseCode));
    }

    http.end();
  } else {
    Serial.println("Wi-Fi not connected");
  }
}

void setup() {
  Serial.begin(115200);

  // Motor and sensor pin setup
  pinMode(inputB, INPUT);
  pinMode(inputR, INPUT);
  pinMode(inputO, INPUT);
  pinMode(inputY, INPUT);
  pinMode(inputG, INPUT);
  pinMode(distanceSensor, INPUT);
  pinMode(motor1PWM, OUTPUT);
  pinMode(motor1PH, OUTPUT);
  pinMode(motor2PWM, OUTPUT);
  pinMode(motor2PH, OUTPUT);

  // Wi-Fi setup
  Serial.println("Connecting to Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected to Wi-Fi");

  // Initialize the next checkpoint
  nextCheckpoint = getNextCheckpoint();
}

void loop() {
  sharpLeftTurnFlag = analogRead(inputB) < LightBoundary;
  sharpRightTurnFlag = analogRead(inputG) < LightBoundary;
  noTurnFlag = analogRead(inputO) < LightBoundary;
  leftTurnFlag = analogRead(inputR) < LightBoundary;
  rightTurnFlag = analogRead(inputY) < LightBoundary;
  parkFlag = analogRead(distanceSensor) > 2400;

  if (noTurnFlag && !rightTurnFlag && !leftTurnFlag) {
    setMotor(0, 1, speed, speed); // Straight
  } else if (leftTurnFlag && !rightTurnFlag) {
    setMotor(0, 1, speed, speed - 60); // Slight left
  } else if (!leftTurnFlag && rightTurnFlag) {
    setMotor(0, 1, speed - 60, speed); // Slight right
  } else if (noTurnFlag && leftTurnFlag && rightTurnFlag) {
    setMotor(0, 1, 0, 0); // Stop
    notifyServer(currentCheckpoint);
    Serial.println("Pause");

    lastCheckpoint = currentCheckpoint;
    currentCheckpoint = nextCheckpoint;

    nextCheckpoint = getNextCheckpoint();
    if (nextCheckpoint == -1) {
      Serial.println("Failed to update next checkpoint. Retrying...");
      delay(2000); // Wait before retrying
      nextCheckpoint = getNextCheckpoint();
    }

    Serial.print("Last Checkpoint: ");
    Serial.println(lastCheckpoint);
    Serial.print("Current Checkpoint: ");
    Serial.println(currentCheckpoint);
    Serial.print("Next Checkpoint: ");
    Serial.println(nextCheckpoint);

    delay(1000);
    setMotor(0, 1, speed, speed); // Resume
    delay(300);
    Serial.println("Start");
  } else if (sharpLeftTurnFlag) {
    setMotor(0, 1, speed, speed - 150); // Sharp left
  } else if (sharpRightTurnFlag) {
    setMotor(0, 1, speed - 150, speed); // Sharp right
  }
}
