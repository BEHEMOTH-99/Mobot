void setup() {  WiFi.mode(WIFI_STA);

  // Init ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error initializing ESP-NOW");
    return;
  }

  // Once ESPNow is successfully Init, we will register for Send CB to
  // get the status of Trasnmitted packet
  esp_now_register_send_cb(OnDataSent);
  
  // Register peer
  memcpy(peerInfo.peer_addr, broadcastAddress, 6);
  peerInfo.channel = 0;  
  peerInfo.encrypt = false;
  
  // Add peer        
  if (esp_now_add_peer(&peerInfo) != ESP_OK){
    Serial.println("Failed to add peer");
    return;
  }

  Serial.begin(115200);
  pinMode(inputB, INPUT);  // Far left side
  pinMode(inputR, INPUT);  // Left side
  pinMode(inputO, INPUT);  // Middle 
  pinMode(inputY, INPUT);  // Right side
  pinMode(inputG, INPUT);  // Far right side
  pinMode(distanceSensor, INPUT);
  pinMode(motor1PWM, OUTPUT);
  pinMode(motor1PH, OUTPUT);
  pinMode(motor2PWM, OUTPUT);
  pinMode(motor2PH, OUTPUT);

  Serial.println("Connecting to Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected to Wi-Fi");

  // Initialize the next checkpoint
  while(true){
    lineFollow();
    if(atNodeNP()){
      stop();
      lastNode = -1;
      currentCheckpoint = 0;
      nextCheckpoint = getNextCheckpoint();
      delay(100);
      Serial.println("loop about to break");
      straight();
      break;
      Serial.println("loop did not break");
    }

  }
  pinMode(RI, OUTPUT);  
  digitalWrite(RI, HIGH); 

  pinMode(LI, OUTPUT);  
  digitalWrite(LI, HIGH); 
  
  pinMode(BL, OUTPUT);  
  digitalWrite(BL, HIGH;
  
  pinMode(HL, OUTPUT);  
  digitalWrite(HL, HIGH);
  
  pinMode(RL, OUTPUT);  
  digitalWrite(RL, HIGH);   
}

int routeID(int current, int next){
  return((current-next)*(current+next));
  //Serial.println(current);
  //Serial.println(next);
}


