void _0_to_1(){
  if((lastNode == 1) || (lastNode == 2)){
    turn180();
  }
  lock = 0;
  straight();
  while(1){
    lineFollow();
    if(atNodeNP()){
      lock += 1;
    }
    if(lock == 1){
      leftTurn90();
      lock = 2;
    }
    else if(lock == 3){
      straight();
      break;
    }
  }
  lastNode = 0;
}

