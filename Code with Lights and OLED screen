void drawThickCircle(int x, int y, int radius, int thickness, int color) {
  for (int i = 0; i < thickness; i++) {
    display.drawCircle(x, y, radius + i, color);
  }
}
void OpenEye(){
  drawThickCircle(SCREEN_WIDTH / 2, (SCREEN_HEIGHT / 2)+15, 0, 31, WHITE);
