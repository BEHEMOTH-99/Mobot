void _0_to_1(){
  lock = 0;
  while(1){
    lineFollow();
    if(atNodeNP()){
      lock += 1;
    }
    if(lock == 1){
      lock = 2;
      straight();
    }
    else if(lock == 3){
      leftTurn90();
      lock = 4;
    }
    else if(lock == 5){
      straight();
      break;
    }
  }
  lastNode = 0;
}

