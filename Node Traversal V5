void obstructionManeuver(){
  int countRepeat = 0;
  int countLim = 0;
  Serial.println("OBSTRUCTION");
  stop();
  myServo.write(0); // turns right
  delay(500);
  const bool direction = maneuverTurn(path[currentPathIndex], path[currentPathIndex+1], countRepeat);
  if(direction){
    myServo.write(180);
  }
  else{
    myServo.write(0);
  }

  // If direction = true, then first turn upon meeting object was right turn, meaning last turn must be same
  stop();
  delay(500);
  while(1){
    countRepeat++;
    Serial.println("CountRepeat = : ");
    Serial.print(countRepeat);
    if(countRepeat == 1){
      countLim = 140;
    }
    else{
      countLim = 170;
    }
    int objectCountCont = 0;
    while(1){
    //Serial.println("Enterred inner while loop");
    setMotor(0, 1, speed, speed);
    if(sonicDistance > distanceThreshold){
      objectCountCont++;
    }
    if(objectCountCont > countLim){
      stop();
      break;
    }
    delay(10);
    }
    Serial.println("BEFORE TURN STAGE 1");
    maneuverTurn(path[currentPathIndex], path[currentPathIndex+1], countRepeat);
    if(countRepeat >= 2){
      while(1){
        noTurnFlag = analogRead(inputO) < LightBoundary;
        leftTurnFlag = analogRead(inputR) < LightBoundary;
        rightTurnFlag = analogRead(inputY) < LightBoundary;
        setMotor(0, 1, speed, speed);
        if(noTurnFlag && leftTurnFlag && rightTurnFlag && direction){
          rightTurn90();
          break;
        }
        else if(noTurnFlag && leftTurnFlag && rightTurnFlag && !direction){
          leftTurn90();
          break;
        }
      }
      break;
    }
  }
}

