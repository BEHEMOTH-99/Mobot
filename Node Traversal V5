int findMinDistance(int distance[], bool visited[]) {
  int min = INF, minIndex = -1;

  for (int i = 0; i < NUM_CHECKPOINTS; i++) {
    if (!visited[i] && distance[i] < min) {
      min = distance[i];
      minIndex = i;
    }
  }
  return minIndex;
}

// Dijkstra’s algorithm implementation
void dijkstra(int (&graph)[NUM_CHECKPOINTS][NUM_CHECKPOINTS], int start, int target, int path[], int spacer) {
    int distance[NUM_CHECKPOINTS];
    bool visited[NUM_CHECKPOINTS];
    int prev[NUM_CHECKPOINTS];

    Serial.println("\nINSIDE DIJKSTRA");
    Serial.println("Checking Graph Update:");
    Serial.print("graph[start][target]: ");
    Serial.println(graph[start][target]); // Should be INF if path was blocked
    Serial.println(graph[0][4]);

    for (int i = 0; i < NUM_CHECKPOINTS; i++) {
        distance[i] = INF;
        visited[i] = false;
        prev[i] = -1;
    }
    distance[start] = 0;

    for (int count = 0; count < NUM_CHECKPOINTS - 1; count++) {
        int u = findMinDistance(distance, visited);
        if (u == -1) break;

        if (spacer == 2 && u == 5) continue; // Skip node 5 if needed

        visited[u] = true;

        for (int v = 0; v < NUM_CHECKPOINTS; v++) {
            if (spacer == 2 && v == 5) continue;
            if (!visited[v] && graph[u][v] > 0 && graph[u][v] < INF) { // Ensure not considering INF paths
                if (distance[u] + graph[u][v] < distance[v]) {
                    distance[v] = distance[u] + graph[u][v];
                    prev[v] = u;
                }
            }
        }
    }

    // Debugging: Print distances to each node
    Serial.println("Final Distance Array:");
    for (int i = 0; i < NUM_CHECKPOINTS; i++) {
        Serial.print("Node ");
        Serial.print(i);
        Serial.print(": ");
        Serial.println(distance[i]);
    }

    Serial.println("Previous Nodes:");
    for (int i = 0; i < NUM_CHECKPOINTS; i++) {
        Serial.print("prev[");
        Serial.print(i);
        Serial.print("] = ");
        Serial.println(prev[i]);
    }

    int current = target, index = 0;
    while (current != -1) {
        path[index++] = current;
        current = prev[current];
    }

    for (int i = 0; i < index / 2; i++) {
        int temp = path[i];
        path[i] = path[index - i - 1];
        path[index - i - 1] = temp;
    }

    path[index] = -1;

    Serial.print("Updated Path: ");
    for (int i = 0; path[i] != -1; i++) {
        Serial.print(path[i]);
        Serial.print(" -> ");
    }
    Serial.println();
}



