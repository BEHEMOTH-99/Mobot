  Serial.println(stage);
  if(wallRightSide(cur, next)){
    if(stage == 0){
      maneuverLeftTurn();
      return false;
    }
    else{
      Serial.println("TURNING RIGHT");
      maneuverRightTurn();
      return true;
    }
  }
  else{
    if(stage == 0){
      maneuverRightTurn();
      return true;
    }
    else{
      maneuverLeftTurn();
      Serial.println("TURNING LEFT");
      return false;
    }
  }
}

