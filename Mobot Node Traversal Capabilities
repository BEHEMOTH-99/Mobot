const int motor1PWM = 36;
const int motor1PH = 35;
const int motor2PWM = 38;
const int motor2PH = 37;
const int distanceSensor = 16;

const int inputB = 4;  // Left
const int inputR = 5;
const int inputO = 6;  // Middle
const int inputY = 7;
const int inputG = 15;  // Right

//Set speed to 0 in order to turn off
const int speed = 150;  //90 speed it works
//const int LowerLightLimit = 200;
//const int UpperLightLimit = 2000;
const int LightBoundary = 900;
volatile bool leftTurnFlag = false;
volatile bool rightTurnFlag = false;
volatile bool noTurnFlag = false;
volatile bool sharpRightTurnFlag = false;
volatile bool sharpLeftTurnFlag = false;
volatile bool entry = true;
const bool parkMode = false;  // set to true for car to move straight until it meets a wall and stops
volatile int lock = 0;

void setup() {
  Serial.begin(9600);
  pinMode(inputB, INPUT);  // Far left side
  pinMode(inputR, INPUT);  // Left side
  pinMode(inputO, INPUT);  // Middle 
  pinMode(inputY, INPUT);  // Right side
  pinMode(inputG, INPUT);  // Far right side
  pinMode(distanceSensor, INPUT);
  pinMode(motor1PWM, OUTPUT);
  pinMode(motor1PH, OUTPUT);
  pinMode(motor2PWM, OUTPUT);
  pinMode(motor2PH, OUTPUT);
}

bool atNode(){
  if (noTurnFlag && leftTurnFlag && rightTurnFlag){
    setMotor(0, 1, 0, 0);
    delay(1000);
    setMotor(0, 1, speed, speed);
    delay(300);
    return true;
  }
  return false;
}

bool atNodeNP(){
  if (noTurnFlag && leftTurnFlag && rightTurnFlag){
    return true;
  }
  return false;
}

void pause_(){
  setMotor(0, 1, 0, 0);
  delay(1000);
  setMotor(0, 1, speed, speed);
  delay(300);
}

void lineFollow(){
  sharpLeftTurnFlag = analogRead(inputB) < LightBoundary;
  sharpRightTurnFlag = analogRead(inputG) < LightBoundary;
  noTurnFlag = analogRead(inputO) < LightBoundary;
  leftTurnFlag = analogRead(inputR) < LightBoundary;
  rightTurnFlag = analogRead(inputY) < LightBoundary;

  //MAKE it go faster if going straight

  if(noTurnFlag && !rightTurnFlag && !leftTurnFlag){
    setMotor(0, 1, speed, speed);
  }
 
  else if (leftTurnFlag && !rightTurnFlag){
    setMotor(0, 1, speed, speed-60);
  }

  else if (!leftTurnFlag && rightTurnFlag){
    setMotor(0, 1, speed-60, speed);
  }

  else if (sharpLeftTurnFlag){
    setMotor(0, 1, speed, speed-150);
  }

  else if (sharpRightTurnFlag){
    setMotor(0, 1, speed-150, speed);
  }

}

void park(){
    if (parkMode){
    while(1){
      setMotor(0, 1, speed, speed);
      delay(30);
      if(analogRead(distanceSensor) > 1800){
        while(1){
          setMotor(0, 1, 0, 0);
          delay(30);
        }
      }
    }
  }
}

void setMotor(bool M1direction, bool M2direction, int M1speed, int M2speed){
  digitalWrite(motor1PH, M1direction);
  digitalWrite(motor2PH, M2direction);
  analogWrite(motor1PWM, M1speed);
  analogWrite(motor2PWM, M2speed);
}

void stop(){
  setMotor(0, 0, 0, 0);
}

void straight(){
  setMotor(0, 1, speed, speed);
  delay(250);
}

