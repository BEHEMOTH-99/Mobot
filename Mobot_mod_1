const int motor1PWM = 36;
const int motor1PH = 35;
const int motor2PWM = 38;
const int motor2PH = 37;

const int inputB = 4;
const int inputR = 5;
const int inputO = 6;
const int inputY = 7;
const int inputG = 15;

//Set speed to 0 in order to turn off
const int speed = 200;
//const int LowerLightLimit = 200;
//const int UpperLightLimit = 2000;
const int LightBoundary = 900;
volatile bool leftTurnFlag = false;
volatile bool rightTurnFlag = false;
volatile bool noTurnFlag = false;

void setMotor(bool M1direction, bool M2direction, int M1speed, int M2speed){
  digitalWrite(motor1PH, M1direction);
  digitalWrite(motor2PH, M2direction);
  analogWrite(motor1PWM, M1speed);
  analogWrite(motor2PWM, M2speed);
}


void setup() {
  Serial.begin(9600);
  pinMode(inputB, INPUT);
  pinMode(inputR, INPUT);
  pinMode(inputO, INPUT);
  pinMode(inputY, INPUT);
  pinMode(inputG, INPUT);
  pinMode(motor1PWM, OUTPUT);
  pinMode(motor1PH, OUTPUT);
  pinMode(motor2PWM, OUTPUT);
  pinMode(motor2PH, OUTPUT);
}

//Make a function that takes speed and phase for motors 1 & 2, and call it in the loop.

void loop() {
  if(analogRead(inputO) < LightBoundary){noTurnFlag = true;}
  else{noTurnFlag = false;}

  if(analogRead(inputR) < LightBoundary){leftTurnFlag = true;}
  else{leftTurnFlag = false;}

  if(analogRead(inputY) < LightBoundary){rightTurnFlag = true;}
  else{rightTurnFlag = false;}

  if(noTurnFlag){
    setMotor(0, 1, speed, speed)
  }

  else if (leftTurnFlag && !rightTurnFlag){
    digitalWrite(motor1PH, 0);
    digitalWrite(motor2PH, 1);
    analogWrite(motor1PWM, speed);
    analogWrite(motor2PWM, speed-80);
    if(noTurnFlag){leftTurnFlag = false;}
  }

  else if (!leftTurnFlag && rightTurnFlag){
    digitalWrite(motor1PH, 0);
    digitalWrite(motor2PH, 1);
    analogWrite(motor1PWM, speed-80);
    analogWrite(motor2PWM, speed);
    if(noTurnFlag){rightTurnFlag = false;}
  }

  //else if(leftTurnFlag && rightTurnFlag){
    //analogWrite(motor1PWM, 0);
    //analogWrite(motor2PWM, 0);
    //delay(1500);
    //leftTurnFlag = 0;
  //rightTurnFlag = 0;
  //}

  Serial.print(analogRead(inputY));
  Serial.print("\n");
  delay(200);

}
