const int motor1PWM = 36;
const int motor1PH = 35;
const int motor2PWM = 38;
const int motor2PH = 37;

const int inputB = 4;
const int inputR = 5;
const int inputO = 6;
const int inputY = 7;
const int inputG = 15;

//Set speed to 0 in order to turn off
const int speed = 100;
volatile bool direction = 0;
volatile int test_direction = 1;

void setup() {
  pinMode(inputB, INPUT);
  pinMode(inputR, INPUT);
  pinMode(inputO, INPUT);
  pinMode(inputY, INPUT);
  pinMode(inputG, INPUT);
  pinMode(motor1PWM, OUTPUT);
  pinMode(motor1PH, OUTPUT);
  pinMode(motor2PWM, OUTPUT);
  pinMode(motor2PH, OUTPUT);
}

void loop() {

if(test_direction == 1){
  digitalWrite(motor1PH, 1);
  digitalWrite(motor2PH, 0);
  analogWrite(motor1PWM, 250);
  analogWrite(motor2PWM, 250);
  delay(2000);
  test_direction = 2;
}

else if(test_direction == 2){
  digitalWrite(motor1PH, 1);
  digitalWrite(motor2PH, 1);
  analogWrite(motor1PWM, 0);
  analogWrite(motor2PWM, 0);
  delay(2000);
  test_direction = 3;
}

else if(test_direction == 3){
  digitalWrite(motor1PH, 0);
  digitalWrite(motor2PH, 1);
  analogWrite(motor1PWM, 250);
  analogWrite(motor2PWM, 250);
  delay(2000);
  test_direction = 1;
}
}
